# STM32 minidrone Board Configuration
#
# SPDX-License-Identifier: Apache-2.0

# Clock
CONFIG_CLOCK_CONTROL=y

# GPIO
CONFIG_GPIO=y

# Pin controller
CONFIG_PINCTRL=y

# Console
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# UART (for Bluetooth HM-13)
CONFIG_UART_INTERRUPT_DRIVEN=y

# I2C (for MPU6050)
CONFIG_I2C=y

# PWM (for motors)
CONFIG_PWM=y

# ADC (for battery)
CONFIG_ADC=y

# Sensor subsystem (MPU6050)
CONFIG_SENSOR=y

# Watchdog
CONFIG_WATCHDOG=y
